# Copy to .env (scripts/setup_linux.sh does this for you).

# Where the server listens. Keep 127.0.0.1 when using a Cloudflare Tunnel.
APP_HOST=127.0.0.1
APP_PORT=8000
OPEN_BROWSER=false

# Refuse to start unless a password is set. Leave on for remote access.
PUBLIC_MODE=true

# Set with: python scripts/set_password.py   (never type a plain password here)
APP_PASSWORD_HASH=

# Optional: HuggingFace token, needed only for gated models
HF_TOKEN=

# GPU memory strategy: auto, always, never
OFFLOAD=auto
